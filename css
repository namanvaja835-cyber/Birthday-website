/* ====================================================================
   PAGE 4: REASONS I LOVE YOU (MIDNIGHT LAVENDER THEME)
   ==================================================================== */
.reasons-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
