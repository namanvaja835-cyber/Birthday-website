  aspect-ratio: 4 / 5;
  background: #f0e6e7;
  overflow: hidden;
  border-radius: 2px;
}

.polaroid-card.landscape .polaroid-img-wrapper {
  aspect-ratio: 4 / 3;
}

.polaroid-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
  display: block;
}

.polaroid-card:hover .polaroid-img {
  transform: scale(1.06);
}

.polaroid-heart-tag {
  position: absolute;
  bottom: 8px;
  right: 8px;
  width: 32px;
  height: 32px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(4px);
  opacity: 0;
  transform: scale(0.7);
  transition: var(--transition-bounce);
}

.polaroid-card:hover .polaroid-heart-tag {
  opacity: 1;
  transform: scale(1);
}

.polaroid-caption {
  font-family: var(--font-hand);
  font-size: 1.25rem;
  font-weight: 700;
  color: #3b131c;
  text-align: center;
  margin-top: 14px;
  line-height: 1.35;
  min-height: 2.7rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

