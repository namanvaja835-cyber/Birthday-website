}

.timeline-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 45px -8px rgba(18, 51, 36, 0.18);
}

.timeline-badge {
  display: inline-block;
  padding: 4px 14px;
  background: rgba(209, 231, 218, 0.6);
