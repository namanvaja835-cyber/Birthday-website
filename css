}

.timeline-photo-box:hover .timeline-photo {
  transform: scale(1.05);
}

.timeline-photo-hint {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  opacity: 0;
  transform: translateY(4px);
