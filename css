}

.countdown-card {
  background: #ffffff;
  border: 1px solid rgba(212, 175, 55, 0.35);
  border-radius: var(--radius-md);
  padding: 24px 12px;
  box-shadow: 0 10px 25px -5px rgba(184, 134, 11, 0.12);
