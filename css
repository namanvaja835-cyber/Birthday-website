}

.timeline-photo-box:hover .timeline-photo-hint {
  opacity: 1;
  transform: translateY(0);
}

.timeline-desc {
  font-size: 0.95rem;
  color: var(--theme-text-secondary);
  line-height: 1.6;
}

/* ====================================================================
   PAGE 6: BIRTHDAY COUNTDOWN (SPARKLING CHAMPAGNE THEME)
   ==================================================================== */
.countdown-box {
  max-width: 820px;
  margin: 20px auto 0;
  background: var(--theme-card-bg);
  border: 1px solid var(--theme-card-border);
  border-radius: var(--radius-lg);
  padding: 48px 36px;
  text-align: center;
  box-shadow: 0 20px 50px -10px rgba(184, 134, 11, 0.15);
