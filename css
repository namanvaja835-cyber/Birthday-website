}

.timeline-date {
  font-family: var(--font-hand);
  font-size: 1.15rem;
  color: #b8860b;
  font-weight: 700;
  margin-bottom: 12px;
}

.timeline-photo-box {
  width: 100%;
  aspect-ratio: 4 / 5;
  max-height: 440px;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  background: rgba(0, 0, 0, 0.04);
