/* ====================================================================
   LUXURY ROMANTIC BIRTHDAY SURPRISE - STYLESHEET
   MULTI-PAGE SURPRISE WITH DISTINCT THEMES PER PAGE
   ==================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

:root {
  /* Default Luxury Romantic Color Palette */
  --theme-bg: #fdf8f7;
  --theme-text-primary: #3d101a;
  --theme-text-secondary: #743e49;
  --theme-accent: #d6687a;
  --theme-accent-dark: #b24155;
  --theme-accent-glow: rgba(214, 104, 122, 0.4);
  --theme-card-bg: rgba(255, 253, 249, 0.88);
  --theme-card-border: rgba(255, 255, 255, 0.88);
  --theme-nav-bg: rgba(255, 253, 249, 0.88);
  --theme-nav-border: rgba(214, 104, 122, 0.2);
  --theme-nav-text: #743e49;
  --theme-nav-active: #b24155;
  
  --font-script: 'Great Vibes', cursive;
  --font-serif: 'Cormorant Garamond', Georgia, serif;
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-hand: 'Caveat', cursive;
  
  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --radius-full: 9999px;
  
  --transition-smooth: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  --transition-theme: background 0.6s ease, color 0.5s ease, border-color 0.5s ease;
}

/* ====================================================================
   PAGE THEME OVERRIDES (Each page has its own distinctive mood)
   ==================================================================== */

/* 1. HOME: Rose Aurora & Golden Dawn */
body[data-theme="home"] {
  --theme-bg: #fdf8f7;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(at 0% 0%, rgba(254, 211, 219, 0.55) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(252, 237, 238, 0.6) 0px, transparent 50%),
    radial-gradient(at 50% 50%, rgba(255, 253, 249, 0.8) 0px, transparent 60%);
  --theme-text-primary: #3d101a;
  --theme-text-secondary: #743e49;
  --theme-accent: #d6687a;
  --theme-accent-dark: #b24155;
  --theme-accent-glow: rgba(214, 104, 122, 0.4);
  --theme-nav-bg: rgba(255, 253, 249, 0.9);
  --theme-nav-border: rgba(214, 104, 122, 0.2);
  --theme-nav-text: #743e49;
  --theme-nav-active: #b24155;
}

/* 2. LOVE LETTER: Vintage Antique Parchment & Royal Burgundy */
body[data-theme="letter"] {
  --theme-bg: #f7f1e5;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(243, 230, 209, 0.8) 0%, transparent 60%),
    radial-gradient(circle at 80% 70%, rgba(240, 222, 196, 0.7) 0%, transparent 60%),
    linear-gradient(to bottom, #faf5ec, #f0e6d2);
  --theme-text-primary: #3b111a;
  --theme-text-secondary: #662734;
  --theme-accent: #8b1e32;
  --theme-accent-dark: #630f20;
  --theme-accent-glow: rgba(139, 30, 50, 0.35);
  --theme-card-bg: #fffcf5;
  --theme-card-border: rgba(212, 175, 55, 0.45);
  --theme-nav-bg: rgba(250, 245, 236, 0.92);
  --theme-nav-border: rgba(139, 30, 50, 0.25);
  --theme-nav-text: #630f20;
  --theme-nav-active: #8b1e32;
}

/* 3. MEMORIES: Sunset Peach & Pastel Scrapbook */
body[data-theme="memories"] {
  --theme-bg: #fff5f0;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(at 10% 20%, rgba(255, 218, 204, 0.6) 0px, transparent 50%),
    radial-gradient(at 90% 80%, rgba(255, 228, 214, 0.7) 0px, transparent 50%),
    linear-gradient(135deg, #fff8f5 0%, #feebe4 50%, #fff2ec 100%);
  --theme-text-primary: #451b14;
  --theme-text-secondary: #803f33;
  --theme-accent: #e76f51;
  --theme-accent-dark: #c85036;
  --theme-accent-glow: rgba(231, 111, 81, 0.35);
  --theme-card-bg: #ffffff;
  --theme-card-border: rgba(231, 111, 81, 0.25);
  --theme-nav-bg: rgba(255, 245, 240, 0.92);
  --theme-nav-border: rgba(231, 111, 81, 0.25);
  --theme-nav-text: #803f33;
  --theme-nav-active: #c85036;
}

/* 4. REASONS: Celestial Midnight Lavender & Neon Starlight */
body[data-theme="reasons"] {
  --theme-bg: #12071f;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(circle at 50% 15%, rgba(68, 24, 102, 0.8) 0%, transparent 60%),
    radial-gradient(circle at 10% 80%, rgba(42, 10, 68, 0.9) 0%, transparent 50%),
    linear-gradient(180deg, #180929 0%, #0d0417 100%);
  --theme-text-primary: #f8f1ff;
  --theme-text-secondary: #d8bfe8;
  --theme-accent: #f472b6;
  --theme-accent-dark: #ec4899;
  --theme-accent-glow: rgba(244, 114, 182, 0.45);
  --theme-card-bg: rgba(36, 15, 56, 0.78);
  --theme-card-border: rgba(244, 114, 182, 0.35);
  --theme-nav-bg: rgba(18, 7, 31, 0.92);
  --theme-nav-border: rgba(244, 114, 182, 0.3);
  --theme-nav-text: #e9d5ff;
  --theme-nav-active: #ec4899;
}

/* 5. OUR STORY: Fairytale Emerald Forest & Golden Laurel */
body[data-theme="story"] {
  --theme-bg: #f2f7f4;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(at 15% 15%, rgba(209, 231, 218, 0.65) 0px, transparent 50%),
    radial-gradient(at 85% 85%, rgba(220, 237, 226, 0.6) 0px, transparent 50%),
    linear-gradient(150deg, #f6faf7 0%, #e7f0e9 50%, #f4f8f5 100%);
  --theme-text-primary: #123324;
  --theme-text-secondary: #335946;
  --theme-accent: #2d6a4f;
  --theme-accent-dark: #1b4332;
  --theme-accent-glow: rgba(45, 106, 79, 0.35);
  --theme-card-bg: rgba(255, 255, 255, 0.9);
  --theme-card-border: rgba(45, 106, 79, 0.25);
  --theme-nav-bg: rgba(242, 247, 244, 0.92);
  --theme-nav-border: rgba(45, 106, 79, 0.2);
  --theme-nav-text: #335946;
  --theme-nav-active: #2d6a4f;
}

/* 6. COUNTDOWN: Sparkling French Champagne & Gilded Amber */
body[data-theme="countdown"] {
  --theme-bg: #fcf9f2;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(at 20% 20%, rgba(251, 238, 198, 0.65) 0px, transparent 50%),
    radial-gradient(at 80% 80%, rgba(247, 229, 175, 0.6) 0px, transparent 50%),
    linear-gradient(135deg, #fdfbf5 0%, #f7eed8 50%, #fffdf8 100%);
  --theme-text-primary: #3d2f0b;
  --theme-text-secondary: #6e5820;
  --theme-accent: #d4af37;
  --theme-accent-dark: #b8860b;
  --theme-accent-glow: rgba(212, 175, 55, 0.45);
  --theme-card-bg: rgba(255, 255, 255, 0.92);
  --theme-card-border: rgba(212, 175, 55, 0.35);
  --theme-nav-bg: rgba(252, 249, 242, 0.92);
  --theme-nav-border: rgba(212, 175, 55, 0.25);
  --theme-nav-text: #6e5820;
  --theme-nav-active: #b8860b;
}

/* 7. MAKE A WISH: Velvet Obsidian Wine & Candlelight Twilight */
body[data-theme="wish"] {
  --theme-bg: #140207;
  background-color: var(--theme-bg);
  background-image: 
    radial-gradient(circle at center, rgba(82, 12, 29, 0.8) 0%, rgba(20, 2, 7, 0.95) 75%, #0d0104 100%);
  --theme-text-primary: #ffffff;
  --theme-text-secondary: #fbd3dc;
  --theme-accent: #ffd700;
  --theme-accent-dark: #d4af37;
  --theme-accent-glow: rgba(255, 215, 0, 0.45);
  --theme-card-bg: rgba(48, 7, 18, 0.85);
  --theme-card-border: rgba(255, 215, 0, 0.4);
  --theme-nav-bg: rgba(20, 2, 7, 0.92);
  --theme-nav-border: rgba(255, 215, 0, 0.25);
  --theme-nav-text: #ffd8df;
  --theme-nav-active: #d4af37;
}

/* Reset & Base Setup */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  overflow-x: hidden;
  min-height: 100%;
}

body {
  font-family: var(--font-sans);
  color: var(--theme-text-primary);
  background-attachment: fixed;
  line-height: 1.65;
  overflow-x: hidden;
  position: relative;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  transition: var(--transition-theme);
}

/* Floating Interactive Canvas */
#particles-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

/* ====================================================================
   TOP LUXURY NAVIGATION BAR
   ==================================================================== */
.site-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: var(--theme-nav-bg);
  border-bottom: 1px solid var(--theme-nav-border);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  z-index: 1000;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  transition: var(--transition-theme);
}

.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-brand {
  font-family: var(--font-script);
  font-size: 1.85rem;
  color: var(--theme-text-primary);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: transform 0.3s ease, color 0.5s ease;
}

.nav-brand:hover {
  transform: scale(1.04);
}

.nav-menu {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 6px;
}

.nav-item {
  position: relative;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 15px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--theme-nav-text);
  text-decoration: none;
  border-radius: var(--radius-full);
  transition: var(--transition-smooth);
  cursor: pointer;
}

.nav-link:hover {
  background: rgba(255, 255, 255, 0.15);
  color: var(--theme-text-primary);
}

.nav-link.active {
  background: var(--theme-nav-active);
  color: #ffffff !important;
  box-shadow: 0 4px 14px var(--theme-accent-glow);
}

body[data-theme="wish"] .nav-link.active,
body[data-theme="countdown"] .nav-link.active {
  color: #24030a !important;
  font-weight: 700;
}

.nav-mobile-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  color: var(--theme-text-primary);
  font-size: 1.5rem;
}

/* ====================================================================
   MULTI-PAGE VIEW ARCHITECTURE
   ==================================================================== */
.page-container {
  flex: 1;
  position: relative;
  z-index: 2;
  margin-top: 65px;
  min-height: calc(100vh - 65px);
  display: flex;
  flex-direction: column;
}

.page-view {
  display: none;
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  width: 100%;
  flex: 1;
  padding-bottom: 60px;
}

.page-view.active {
  display: block;
  opacity: 1;
  transform: translateY(0);
}

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 2;
}

/* Section Header Shared Styles */
.section-header {
  text-align: center;
  margin-bottom: 44px;
  padding-top: 40px;
  position: relative;
}

.section-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 20px;
  background: rgba(255, 255, 255, 0.25);
  border: 1px solid var(--theme-accent);
  border-radius: var(--radius-full);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--theme-accent-dark);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 14px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

body[data-theme="reasons"] .section-badge {
  color: #fbcfe8;
  background: rgba(244, 114, 182, 0.15);
}

.section-title {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 4.2vw, 3.4rem);
  font-weight: 600;
  color: var(--theme-text-primary);
  letter-spacing: -0.01em;
  line-height: 1.2;
  margin-bottom: 12px;
}

.section-title .script-accent {
  font-family: var(--font-script);
  font-size: 1.35em;
  font-weight: 400;
  color: var(--theme-accent);
  display: inline-block;
  margin: 0 6px;
}

.section-subtitle {
  font-size: 1.08rem;
  color: var(--theme-text-secondary);
  max-width: 620px;
  margin: 0 auto;
  font-weight: 400;
}

/* Page Navigation Footer Controls */
.page-nav-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  max-width: 820px;
  margin: 50px auto 0;
  padding: 20px 0;
  border-top: 1px dashed var(--theme-card-border);
}

.btn-page-nav {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 28px;
  font-size: 0.98rem;
  font-weight: 600;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: var(--transition-bounce);
  text-decoration: none;
}

.btn-page-nav.prev {
  background: var(--theme-card-bg);
  border: 1px solid var(--theme-card-border);
  color: var(--theme-text-secondary);
}

.btn-page-nav.prev:hover {
  color: var(--theme-text-primary);
  transform: translateX(-4px);
}

.btn-page-nav.next {
  background: linear-gradient(135deg, var(--theme-accent) 0%, var(--theme-accent-dark) 100%);
  border: none;
  color: #ffffff;
  box-shadow: 0 8px 22px var(--theme-accent-glow);
  margin-left: auto;
}

body[data-theme="reasons"] .btn-page-nav.next,
body[data-theme="countdown"] .btn-page-nav.next,
body[data-theme="wish"] .btn-page-nav.next {
  color: #1a0826;
  font-weight: 700;
}

.btn-page-nav.next:hover {
  transform: translateX(4px) scale(1.02);
  box-shadow: 0 12px 28px var(--theme-accent-glow);
}

/* ====================================================================
   PAGE 1: HERO / HOME
   ==================================================================== */
.hero-wrapper {
  min-height: calc(100vh - 65px);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 40px 24px 60px;
  overflow: hidden;
}

.hero-bg-blobs {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.45;
  animation: floatBlobs 14s ease-in-out infinite alternate;
}

.blob-1 {
  top: 10%;
  left: 10%;
  width: 380px;
  height: 380px;
  background: #fed3db;
}

.blob-2 {
  bottom: 15%;
  right: 8%;
  width: 420px;
  height: 420px;
  background: #fedce3;
  animation-delay: -5s;
}

.blob-3 {
  top: 45%;
  left: 60%;
  width: 320px;
  height: 320px;
  background: #fbeea9;
  opacity: 0.3;
  animation-delay: -9s;
}

@keyframes floatBlobs {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(35px, -35px) scale(1.08); }
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 820px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 24px;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(214, 104, 122, 0.3);
  border-radius: var(--radius-full);
  font-size: 0.95rem;
  font-weight: 600;
  color: #b24155;
  box-shadow: 0 8px 20px -6px rgba(214, 104, 122, 0.25);
  backdrop-filter: blur(12px);
}

.hero-image-wrapper {
  position: relative;
  width: 250px;
  height: 250px;
  margin: 8px auto;
}

.hero-image-ring {
  position: absolute;
  inset: -12px;
  border-radius: 50%;
  background: linear-gradient(135deg, #d4af37, #d6687a, #fbeea9);
  opacity: 0.85;
  filter: blur(6px);
  animation: rotateRing 12s linear infinite;
}

.hero-image-frame {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  border: 4px solid #ffffff;
  box-shadow: 0 18px 45px rgba(110, 21, 38, 0.25);
}

.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.hero-image-frame:hover .hero-image {
  transform: scale(1.08);
}

.hero-sparkle-badge {
  position: absolute;
  bottom: 0;
  right: 12px;
  background: #ffffff;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  box-shadow: 0 6px 18px rgba(110, 21, 38, 0.2);
  animation: pulseBadge 2.5s infinite;
}

@keyframes rotateRing {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes pulseBadge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}

.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(2.6rem, 5.8vw, 4.4rem);
  font-weight: 700;
  color: var(--theme-text-primary);
  line-height: 1.15;
  letter-spacing: -0.01em;
}

.hero-title .script-title {
  font-family: var(--font-script);
  font-size: 1.25em;
  font-weight: 400;
  color: var(--theme-accent-dark);
  display: block;
  margin-top: 4px;
}

.hero-subtitle {
  font-size: clamp(1.05rem, 2vw, 1.25rem);
  color: var(--theme-text-secondary);
  font-weight: 400;
  max-width: 620px;
  margin: 0 auto;
}

.hero-cta-group {
  margin-top: 10px;
}

.btn-romantic {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 16px 38px;
  font-size: 1.15rem;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #d6687a 0%, #6e1526 100%);
  border: none;
  border-radius: var(--radius-full);
  box-shadow: 0 12px 30px -5px rgba(214, 104, 122, 0.4);
  cursor: pointer;
  text-decoration: none;
  transition: var(--transition-bounce);
  position: relative;
  overflow: hidden;
  animation: pulseGlow 2.5s infinite;
}

.btn-romantic:hover {
  transform: translateY(-4px) scale(1.03);
  box-shadow: 0 18px 40px -5px rgba(214, 104, 122, 0.55);
}

@keyframes pulseGlow {
  0% { box-shadow: 0 10px 25px -5px rgba(214, 104, 122, 0.4), 0 0 0 0 rgba(214, 104, 122, 0.4); }
  70% { box-shadow: 0 14px 35px -5px rgba(214, 104, 122, 0.4), 0 0 0 16px rgba(214, 104, 122, 0); }
  100% { box-shadow: 0 10px 25px -5px rgba(214, 104, 122, 0.4), 0 0 0 0 rgba(214, 104, 122, 0); }
}

/* ====================================================================
   PAGE 2: THE LETTER (VINTAGE PARCHMENT THEME)
   ==================================================================== */
.envelope-wrapper {
  max-width: 820px;
  margin: 0 auto;
}

.envelope-card {
  background: var(--theme-card-bg);
  border-radius: var(--radius-lg);
  border: 1px solid var(--theme-card-border);
  box-shadow: 
    0 24px 60px -15px rgba(99, 15, 32, 0.16),
    0 0 0 8px rgba(255, 255, 255, 0.7),
    inset 0 0 80px rgba(243, 230, 209, 0.6);
  padding: clamp(36px, 6vw, 68px);
  position: relative;
  overflow: hidden;
}

.envelope-card::before {
  content: '';
  position: absolute;
  inset: 12px;
  border: 1px dashed rgba(139, 30, 50, 0.35);
  border-radius: calc(var(--radius-lg) - 8px);
  pointer-events: none;
}

.envelope-decor-corner {
  position: absolute;
  font-size: 1.4rem;
  color: #d4af37;
  opacity: 0.7;
}
.envelope-decor-corner.top-left { top: 20px; left: 20px; }
.envelope-decor-corner.top-right { top: 20px; right: 20px; }
.envelope-decor-corner.bottom-left { bottom: 20px; left: 20px; }
.envelope-decor-corner.bottom-right { bottom: 20px; right: 20px; }

.letter-header {
  text-align: center;
  margin-bottom: 36px;
  position: relative;
}

.letter-badge-icon {
  font-size: 2.2rem;
  margin-bottom: 8px;
  display: inline-block;
  animation: heartPulse 2s infinite;
}

.letter-salutation {
  font-family: var(--font-script);
  font-size: 2.5rem;
  color: var(--theme-accent-dark);
  margin-bottom: 24px;
}

.letter-body {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.letter-paragraph {
  font-family: var(--font-serif);
  font-size: clamp(1.15rem, 2.2vw, 1.35rem);
  line-height: 1.85;
  color: #38121a;
