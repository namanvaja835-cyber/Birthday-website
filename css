/* 3D Birthday Cake */
.cake-wrapper {
  margin: 16px 0 6px;
  position: relative;
  cursor: pointer;
}

.cake {
  position: relative;
  width: 180px;
  height: 120px;
  margin: 0 auto;
}

.cake-plate {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 220px;
  height: 16px;
  background: #f0e6e7;
  border-radius: 10px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
}

.cake-bottom {
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  width: 170px;
  height: 55px;
  background: linear-gradient(to right, #e87b92, #f59eb0, #e87b92);
  border-radius: 10px 10px 4px 4px;
  box-shadow: inset 0 -6px 12px rgba(0, 0, 0, 0.2);
}

.cake-top {
  position: absolute;
  bottom: 66px;
  left: 50%;
  transform: translateX(-50%);
  width: 130px;
  height: 45px;
  background: linear-gradient(to right, #fff4f6, #ffe1e8, #fff4f6);
  border-radius: 10px 10px 4px 4px;
  box-shadow: inset 0 -4px 8px rgba(0, 0, 0, 0.15);
}

.cake-candle {
  position: absolute;
  bottom: 110px;
  left: 50%;
  transform: translateX(-50%);
  width: 10px;
  height: 35px;
  background: repeating-linear-gradient(45deg, #d4af37, #d4af37 6px, #ffffff 6px, #ffffff 12px);
  border-radius: 4px;
}

.candle-flame {
  position: absolute;
  top: -18px;
  left: 50%;
  transform: translateX(-50%);
  width: 14px;
  height: 22px;
  background: radial-gradient(ellipse at bottom, #ffee55 0%, #ff8800 65%, rgba(255, 0, 0, 0) 100%);
  border-radius: 50% 50% 35% 35%;
  filter: drop-shadow(0 0 10px #ffaa00);
  animation: flicker 1s ease-in-out infinite alternate;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.candle-flame.blown-out {
  opacity: 0;
  transform: translateX(-50%) scale(0);
}

@keyframes flicker {
  0% { transform: translateX(-50%) rotate(-2deg) scale(1); }
  100% { transform: translateX(-50%) rotate(2deg) scale(1.08); }
}

.candle-smoke {
  position: absolute;
  top: -30px;
  left: 50%;
  transform: translateX(-50%);
  width: 8px;
  height: 24px;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  filter: blur(3px);
  opacity: 0;
}

.candle-smoke.active {
  animation: smokeRise 1.6s ease-out forwards;
}

@keyframes smokeRise {
  0% { opacity: 0.8; transform: translateX(-50%) scale(1); }
  100% { opacity: 0; transform: translate(-30%, -40px) scale(3); }
}

.cake-hint {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6px;
  letter-spacing: 0.04em;
}

.btn-wish {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 18px 44px;
  font-size: 1.2rem;
  font-weight: 700;
  color: #24030a;
  background: linear-gradient(135deg, #ffd700 0%, #fbeea9 50%, #d4af37 100%);
  border: none;
  border-radius: var(--radius-full);
  box-shadow: 0 12px 35px rgba(212, 175, 55, 0.45);
  cursor: pointer;
  transition: var(--transition-bounce);
  animation: pulseGlowGold 2.5s infinite;
}

.btn-wish:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 18px 45px rgba(212, 175, 55, 0.6);
}

@keyframes pulseGlowGold {
  0% { box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4); }
  50% { box-shadow: 0 16px 40px rgba(212, 175, 55, 0.7); }
  100% { box-shadow: 0 10px 25px rgba(212, 175, 55, 0.4); }
}

/* Wish Confirmation Modal */
.wish-modal {
  position: fixed;
  inset: 0;
  background: rgba(14, 2, 5, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
  padding: 24px;
}

.wish-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.wish-card {
  background: #fffcf5;
  border: 2px solid #d4af37;
  border-radius: var(--radius-lg);
  padding: 48px 36px;
  max-width: 540px;
  width: 100%;
  text-align: center;
  color: #3b111a;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  transform: scale(0.85);
  transition: var(--transition-bounce);
  position: relative;
}

.wish-modal.active .wish-card {
  transform: scale(1);
}

.wish-icon {
  font-size: 3.5rem;
  margin-bottom: 16px;
  animation: heartPulse 1.5s infinite;
}

.wish-title {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  color: #5c111e;
  margin-bottom: 14px;
}

.wish-message {
  font-size: 1.15rem;
  color: #662734;
  line-height: 1.7;
  margin-bottom: 28px;
  white-space: pre-line;
}

.btn-close-wish {
  padding: 12px 32px;
  background: #b24155;
  color: #ffffff;
  border: none;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.btn-close-wish:hover {
  background: #6e1526;
  transform: scale(1.05);
}

/* ====================================================================
   FLOATING ROMANTIC MUSIC PLAYER
   ==================================================================== */
.music-player-pill {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 22px 10px 14px;
  background: var(--theme-nav-bg);
  border: 1px solid var(--theme-nav-border);
  border-radius: var(--radius-full);
  box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  cursor: pointer;
  transition: var(--transition-bounce);
}

.music-player-pill:hover {
  transform: translateY(-4px) scale(1.04);
  box-shadow: 0 16px 36px -5px rgba(0, 0, 0, 0.35);
}

.music-btn-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--theme-accent), var(--theme-accent-dark));
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 4px 12px var(--theme-accent-glow);
  transition: var(--transition-smooth);
}

.music-info {
  display: flex;
  flex-direction: column;
}

.music-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--theme-text-primary);
  line-height: 1.2;
}

.music-sub {
  font-size: 0.74rem;
  color: var(--theme-text-secondary);
}

.music-wave {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 18px;
  margin-left: 4px;
}

.wave-bar {
  width: 3px;
  height: 4px;
  background: var(--theme-accent);
  border-radius: 2px;
  transition: height 0.2s ease;
}

.music-player-pill.playing .wave-bar:nth-child(1) { animation: waveAnimation 0.9s ease infinite alternate; }
.music-player-pill.playing .wave-bar:nth-child(2) { animation: waveAnimation 1.2s ease infinite alternate 0.2s; }
.music-player-pill.playing .wave-bar:nth-child(3) { animation: waveAnimation 0.8s ease infinite alternate 0.4s; }
.music-player-pill.playing .wave-bar:nth-child(4) { animation: waveAnimation 1.1s ease infinite alternate 0.1s; }

@keyframes waveAnimation {
  0% { height: 4px; }
  100% { height: 18px; }
}

/* ====================================================================
   FOOTER & SECRET EASTER EGG
   ==================================================================== */
.site-footer {
  background: rgba(14, 2, 5, 0.95);
  color: rgba(255, 255, 255, 0.7);
  padding: 36px 0 28px;
  text-align: center;
  position: relative;
  z-index: 2;
  margin-top: auto;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.footer-easter-egg {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #ff758c;
  font-size: 1.2rem;
  cursor: pointer;
  transition: var(--transition-bounce);
}

.footer-easter-egg:hover {
  transform: scale(1.3) rotate(15deg);
  background: #ff758c;
  color: #ffffff;
  box-shadow: 0 0 15px #ff758c;
}

.footer-text {
  font-size: 0.92rem;
  letter-spacing: 0.04em;
}

.footer-sub {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.45);
}

/* Secret Easter Egg Modal */
.secret-modal {
  position: fixed;
  inset: 0;
  background: rgba(18, 2, 6, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  padding: 24px;
}

.secret-modal.active {
  opacity: 1;
  pointer-events: auto;
}

.secret-card {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 42px 32px;
  max-width: 480px;
  width: 100%;
  text-align: center;
  border: 2px dashed #d6687a;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

/* Click Particle Heart */
.click-heart {
  position: fixed;
  pointer-events: none;
  z-index: 99999;
  font-size: 1.4rem;
  animation: floatHeartClick 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

@keyframes floatHeartClick {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
  100% { transform: translate(-50%, -120px) scale(1.4); opacity: 0; }
}

@keyframes heartPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}

/* ====================================================================
   RESPONSIVE DESIGN (MOBILE & TABLET)
   ==================================================================== */
@media (max-width: 992px) {
  .nav-menu {
    position: fixed;
    top: 65px;
    left: 0;
    width: 100%;
    background: var(--theme-nav-bg);
    backdrop-filter: blur(16px);
    flex-direction: column;
    padding: 20px 24px;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--theme-nav-border);
    display: none;
    gap: 10px;
  }

  .nav-menu.mobile-open {
    display: flex;
  }

  .nav-link {
    width: 100%;
    justify-content: center;
    padding: 12px 18px;
    font-size: 1rem;
  }

  .nav-mobile-toggle {
    display: block;
  }

  .timeline-line {
    left: 28px;
  }
  
  .timeline-item {
    width: 100%;
    padding-left: 68px;
    padding-right: 0;
  }
  
  .timeline-item.left,
  .timeline-item.right {
    left: 0;
    text-align: left;
  }
  
  .timeline-item.left .timeline-node,
  .timeline-item.right .timeline-node {
    left: 10px;
    right: auto;
  }

  .countdown-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
}

@media (max-width: 768px) {
  .hero-image-wrapper {
    width: 210px;
    height: 210px;
  }
  
  .scrapbook-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  
  .music-player-pill {
    bottom: 16px;
    right: 16px;
    padding: 8px 16px 8px 10px;
  }
  
  .music-sub {
    display: none;
  }

  .page-nav-controls {
    flex-direction: column;
    gap: 12px;
  }

  .btn-page-nav {
    width: 100%;
    justify-content: center;
  }
  
  .lightbox-nav-btn {
    width: 44px;
    height: 44px;
    font-size: 1.1rem;
  }
  
  .lightbox-nav-btn.prev { left: 10px; }
  .lightbox-nav-btn.next { right: 10px; }
}

@media (max-width: 480px) {
  .scrapbook-grid {
    grid-template-columns: 1fr;
  }
  
  .polaroid-card {
    transform: none !important;
  }
  
  .envelope-card {
    padding: 28px 18px;
  }
  
  .letter-salutation {
    font-size: 2rem;
  }
  
  .letter-signature {
    font-size: 1.9rem;
  }
  
  .countdown-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  .countdown-card {
    padding: 16px 8px;
  }
  
  .btn-romantic,
  .btn-wish {
    padding: 14px 28px;
    font-size: 1.05rem;
    width: 100%;
    justify-content: center;
  }
}
